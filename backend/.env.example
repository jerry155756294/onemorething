OMT_ENVIRONMENT=development
OMT_DATA_DIR=./data
OMT_FRONTEND_URL=http://127.0.0.1:4173
OMT_BACKEND_URL=http://127.0.0.1:8000
OMT_ALLOWED_ORIGINS=
OMT_ENABLE_DEV_LOGIN=1
OMT_DEFAULT_TIMEZONE=Asia/Taipei
# AI provider settings are backend-only; never expose these through Vite.
OMT_AI_PROVIDER=litellm
# Set this to the LiteLLM gateway URL reachable by the backend process.
OMT_AI_BASE_URL=https://api.openai.com/v1
OMT_AI_MODEL=gpt-3.5-turbo
# GPT-3.5 Turbo is a legacy text-only package preset.
# Legacy OMT_OCR_* variables are compatibility aliases only; no separate OCR model is called.
OMT_INGEST_MODEL_IMAGE_PIXELS=3000000
OMT_INGEST_MODEL_IMAGE_DIMENSION=2800
OMT_INGEST_MAX_MODEL_IMAGES=5
OMT_AI_API_KEY=
OMT_AI_TIMEOUT_SECONDS=60
# Required outside development/test. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OMT_CREDENTIAL_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth console callback URLs must match these backend routes exactly.
# Local development:
#   GitHub: http://127.0.0.1:8000/api/auth/github/callback
#   Google: http://127.0.0.1:8000/api/auth/google/callback
# Production: use the public HTTPS backend origin configured in OMT_BACKEND_URL.

OMT_INGEST_MAX_DOCUMENT_ENTRIES=2000
OMT_INGEST_MAX_DOCUMENT_UNCOMPRESSED_BYTES=41943040
